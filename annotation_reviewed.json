{
  "source_license": "CC BY-SA 4.0",
  "sentences": [
    {
      "id": 1,
      "source_title": "Санкт-Петербург",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=785775",
      "text": "Местной еды в Петербурге пожалуй что нет — есть только особые названия и особые традиции её употребления в пышечных, шаверменных и так далее.",
      "numbered_words": "1:Местной 2:еды 3:в 4:Петербурге 5:пожалуй 6:что 7:нет 8:— 9:есть 10:только 11:особые 12:названия 13:и 14:особые 15:традиции 16:её 17:употребления 18:в 19:пышечных 20:, 21:шаверменных 22:и 23:так 24:далее 25:.",
      "spans": [
        {
          "start": 4,
          "end": 4,
          "type": "LOC"
        }
      ]
    },
    {
      "id": 2,
      "source_title": "Великий Новгород",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=712875",
      "text": "Такси можно заказать по телефону, поймать в центре города или у вокзала, либо воспользоваться агрегатором Яндекс-такси, действующим в городе с 2019 года.",
      "numbered_words": "1:Такси 2:можно 3:заказать 4:по 5:телефону 6:, 7:поймать 8:в 9:центре 10:города 11:или 12:у 13:вокзала 14:, 15:либо 16:воспользоваться 17:агрегатором 18:Яндекс-такси 19:, 20:действующим 21:в 22:городе 23:с 24:2019 25:года 26:.",
      "spans": [
        {
          "start": 18,
          "end": 18,
          "type": "ORG"
        }
      ]
    },
    {
      "id": 3,
      "source_title": "Санкт-Петербург",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=785775",
      "text": "Вокзалы Петербурга и некоторые станции оборудованы турникетами автоматического контроля на вход и выход пассажиров.",
      "numbered_words": "1:Вокзалы 2:Петербурга 3:и 4:некоторые 5:станции 6:оборудованы 7:турникетами 8:автоматического 9:контроля 10:на 11:вход 12:и 13:выход 14:пассажиров 15:.",
      "spans": [
        {
          "start": 2,
          "end": 2,
          "type": "LOC"
        }
      ]
    },
    {
      "id": 4,
      "source_title": "Великий Новгород",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=712875",
      "text": "Возможно, тогда же основали и самый первый здешний монастырь, про который летописи сообщают лишь, что в 1386 году он был сожжён самими новгородцами при приближении войска московского князя Дмитрия Донского.",
      "numbered_words": "1:Возможно 2:, 3:тогда 4:же 5:основали 6:и 7:самый 8:первый 9:здешний 10:монастырь 11:, 12:про 13:который 14:летописи 15:сообщают 16:лишь 17:, 18:что 19:в 20:1386 21:году 22:он 23:был 24:сожжён 25:самими 26:новгородцами 27:при 28:приближении 29:войска 30:московского 31:князя 32:Дмитрия 33:Донского 34:.",
      "spans": [
        {
          "start": 32,
          "end": 33,
          "type": "PER"
        }
      ]
    },
    {
      "id": 5,
      "source_title": "Казань",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=763556",
      "text": "Главной улицей Татарской слободы является ул. Габдуллы Тукая, в просторечии Тукаевская.",
      "numbered_words": "1:Главной 2:улицей 3:Татарской 4:слободы 5:является 6:ул 7:. 8:Габдуллы 9:Тукая 10:, 11:в 12:просторечии 13:Тукаевская 14:.",
      "spans": [
        {
          "start": 3,
          "end": 4,
          "type": "LOC"
        },
        {
          "start": 8,
          "end": 9,
          "type": "LOC"
        },
        {
          "start": 13,
          "end": 13,
          "type": "LOC"
        }
      ]
    },
    {
      "id": 6,
      "source_title": "Великий Новгород",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=712875",
      "text": "С основанием Петербурга Новгород окончательно утратил своё торговое значение и постепенно превратился в рядовой провинциальный город.",
      "numbered_words": "1:С 2:основанием 3:Петербурга 4:Новгород 5:окончательно 6:утратил 7:своё 8:торговое 9:значение 10:и 11:постепенно 12:превратился 13:в 14:рядовой 15:провинциальный 16:город 17:.",
      "spans": [
        {
          "start": 3,
          "end": 3,
          "type": "LOC"
        },
        {
          "start": 4,
          "end": 4,
          "type": "LOC"
        }
      ]
    },
    {
      "id": 7,
      "source_title": "Санкт-Петербург",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=785775",
      "text": "Многочисленные мелкие острова были превращены в форты, создав в совокупности с крепостями мощный укрепрайон.",
      "numbered_words": "1:Многочисленные 2:мелкие 3:острова 4:были 5:превращены 6:в 7:форты 8:, 9:создав 10:в 11:совокупности 12:с 13:крепостями 14:мощный 15:укрепрайон 16:.",
      "spans": []
    },
    {
      "id": 8,
      "source_title": "Великий Новгород",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=712875",
      "text": "С машиной всю её можно охватить за несколько часов, двигаясь от церкви на Волотовом поле до Рюрикова городища (или в обратном направлении).",
      "numbered_words": "1:С 2:машиной 3:всю 4:её 5:можно 6:охватить 7:за 8:несколько 9:часов 10:, 11:двигаясь 12:от 13:церкви 14:на 15:Волотовом 16:поле 17:до 18:Рюрикова 19:городища 20:( 21:или 22:в 23:обратном 24:направлении 25:) 26:.",
      "spans": [
        {
          "start": 15,
          "end": 16,
          "type": "LOC"
        },
        {
          "start": 18,
          "end": 19,
          "type": "LOC"
        }
      ]
    },
    {
      "id": 9,
      "source_title": "Великий Новгород",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=712875",
      "text": "Кремлевский парк подходит для неспешной прогулки и радует тенистыми аллеями, фонтанами и памятниками, не говоря уже о видах на старую крепость.",
      "numbered_words": "1:Кремлевский 2:парк 3:подходит 4:для 5:неспешной 6:прогулки 7:и 8:радует 9:тенистыми 10:аллеями 11:, 12:фонтанами 13:и 14:памятниками 15:, 16:не 17:говоря 18:уже 19:о 20:видах 21:на 22:старую 23:крепость 24:.",
      "spans": [
        {
          "start": 1,
          "end": 2,
          "type": "LOC"
        }
      ]
    },
    {
      "id": 10,
      "source_title": "Санкт-Петербург",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=785775",
      "text": "Все экскурсии устроены практически одинаково и проходят в «автоматическом режиме» под аудиозапись, в которой информация о достопримечательностях перемежается декламацией стихов о Петербурге.",
      "numbered_words": "1:Все 2:экскурсии 3:устроены 4:практически 5:одинаково 6:и 7:проходят 8:в 9:« 10:автоматическом 11:режиме 12:» 13:под 14:аудиозапись 15:, 16:в 17:которой 18:информация 19:о 20:достопримечательностях 21:перемежается 22:декламацией 23:стихов 24:о 25:Петербурге 26:.",
      "spans": [
        {
          "start": 25,
          "end": 25,
          "type": "LOC"
        }
      ]
    },
    {
      "id": 11,
      "source_title": "Санкт-Петербург",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=785775",
      "text": "Обычно к оплате принимаются следующие виды карт: Мир, Visa, Visa Electron, MasterCard, MasterCard Electronic и Maestro.",
      "numbered_words": "1:Обычно 2:к 3:оплате 4:принимаются 5:следующие 6:виды 7:карт 8:: 9:Мир 10:, 11:Visa 12:, 13:Visa 14:Electron 15:, 16:MasterCard 17:, 18:MasterCard 19:Electronic 20:и 21:Maestro 22:.",
      "spans": []
    },
    {
      "id": 12,
      "source_title": "Великий Новгород",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=712875",
      "text": "К концу XIV века в городе появились настоящие шедевры.",
      "numbered_words": "1:К 2:концу 3:XIV 4:века 5:в 6:городе 7:появились 8:настоящие 9:шедевры 10:.",
      "spans": []
    },
    {
      "id": 13,
      "source_title": "Великий Новгород",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=712875",
      "text": "Наконец, для всех, кто интересуется российской историей, совершенно естественным будет продолжить путешествие из Новгорода во Псков.",
      "numbered_words": "1:Наконец 2:, 3:для 4:всех 5:, 6:кто 7:интересуется 8:российской 9:историей 10:, 11:совершенно 12:естественным 13:будет 14:продолжить 15:путешествие 16:из 17:Новгорода 18:во 19:Псков 20:.",
      "spans": [
        {
          "start": 17,
          "end": 17,
          "type": "LOC"
        },
        {
          "start": 19,
          "end": 19,
          "type": "LOC"
        }
      ]
    },
    {
      "id": 14,
      "source_title": "Великий Новгород",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=712875",
      "text": "Кроме рейсовых автобусов пассажирские перевозки до Санкт-Петербурга осуществляют транспортные компании «НовгородАвто» и «Атлас».",
      "numbered_words": "1:Кроме 2:рейсовых 3:автобусов 4:пассажирские 5:перевозки 6:до 7:Санкт-Петербурга 8:осуществляют 9:транспортные 10:компании 11:« 12:НовгородАвто 13:» 14:и 15:« 16:Атлас 17:» 18:.",
      "spans": [
        {
          "start": 7,
          "end": 7,
          "type": "LOC"
        },
        {
          "start": 12,
          "end": 12,
          "type": "ORG"
        },
        {
          "start": 16,
          "end": 16,
          "type": "ORG"
        }
      ]
    },
    {
      "id": 15,
      "source_title": "Санкт-Петербург",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=785775",
      "text": "Обязательно проверяйте, с какого вокзала отходит нужный вам поезд!",
      "numbered_words": "1:Обязательно 2:проверяйте 3:, 4:с 5:какого 6:вокзала 7:отходит 8:нужный 9:вам 10:поезд 11:!",
      "spans": []
    },
    {
      "id": 16,
      "source_title": "Великий Новгород",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=712875",
      "text": "Как и другие города, он пережил перепланировку, приводящую к нелепым результатам перестройку старых храмов и новое строительство во всех положенных стилях.",
      "numbered_words": "1:Как 2:и 3:другие 4:города 5:, 6:он 7:пережил 8:перепланировку 9:, 10:приводящую 11:к 12:нелепым 13:результатам 14:перестройку 15:старых 16:храмов 17:и 18:новое 19:строительство 20:во 21:всех 22:положенных 23:стилях 24:.",
      "spans": []
    },
    {
      "id": 17,
      "source_title": "Санкт-Петербург",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=785775",
      "text": "Петербург был основан Петром I как крепость в устье Невы в ходе Северной войны со Швецией.",
      "numbered_words": "1:Петербург 2:был 3:основан 4:Петром 5:I 6:как 7:крепость 8:в 9:устье 10:Невы 11:в 12:ходе 13:Северной 14:войны 15:со 16:Швецией 17:.",
      "spans": [
        {
          "start": 1,
          "end": 1,
          "type": "LOC"
        },
        {
          "start": 4,
          "end": 5,
          "type": "PER"
        },
        {
          "start": 10,
          "end": 10,
          "type": "LOC"
        },
        {
          "start": 16,
          "end": 16,
          "type": "LOC"
        }
      ]
    },
    {
      "id": 18,
      "source_title": "Казань",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=763556",
      "text": "Татарская слобода — наверное, самое большое в мире собрание исторических татарских мечетей, которых в ней пара десятков.",
      "numbered_words": "1:Татарская 2:слобода 3:— 4:наверное 5:, 6:самое 7:большое 8:в 9:мире 10:собрание 11:исторических 12:татарских 13:мечетей 14:, 15:которых 16:в 17:ней 18:пара 19:десятков 20:.",
      "spans": [
        {
          "start": 1,
          "end": 2,
          "type": "LOC"
        }
      ]
    },
    {
      "id": 19,
      "source_title": "Великий Новгород",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=712875",
      "text": "Крупнейшим городским предприятием с собственной развитой инфраструктурой является ОАО «Акрон», выпускающее минеральные удобрения.",
      "numbered_words": "1:Крупнейшим 2:городским 3:предприятием 4:с 5:собственной 6:развитой 7:инфраструктурой 8:является 9:ОАО 10:« 11:Акрон 12:» 13:, 14:выпускающее 15:минеральные 16:удобрения 17:.",
      "spans": [
        {
          "start": 11,
          "end": 11,
          "type": "ORG"
        }
      ]
    },
    {
      "id": 20,
      "source_title": "Санкт-Петербург",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=785775",
      "text": "Все виды билетов можно купить в кассах вокзалов.",
      "numbered_words": "1:Все 2:виды 3:билетов 4:можно 5:купить 6:в 7:кассах 8:вокзалов 9:.",
      "spans": []
    },
    {
      "id": 21,
      "source_title": "Казань",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=763556",
      "text": "Тем не менее, список казанских автостанций этим далеко не исчерпывается.",
      "numbered_words": "1:Тем 2:не 3:менее 4:, 5:список 6:казанских 7:автостанций 8:этим 9:далеко 10:не 11:исчерпывается 12:.",
      "spans": []
    },
    {
      "id": 22,
      "source_title": "Санкт-Петербург",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=785775",
      "text": "Из Хельсинки в Петербург четырежды в день ходят скоростные поезда Аллегро с пограничным контролем во время движения.",
      "numbered_words": "1:Из 2:Хельсинки 3:в 4:Петербург 5:четырежды 6:в 7:день 8:ходят 9:скоростные 10:поезда 11:Аллегро 12:с 13:пограничным 14:контролем 15:во 16:время 17:движения 18:.",
      "spans": [
        {
          "start": 2,
          "end": 2,
          "type": "LOC"
        },
        {
          "start": 4,
          "end": 4,
          "type": "LOC"
        }
      ]
    },
    {
      "id": 23,
      "source_title": "Санкт-Петербург",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=785775",
      "text": "В Петербурге есть множество памятников архитектуры, скульптуры, различных мемориалов, музеев, театров разного направления.",
      "numbered_words": "1:В 2:Петербурге 3:есть 4:множество 5:памятников 6:архитектуры 7:, 8:скульптуры 9:, 10:различных 11:мемориалов 12:, 13:музеев 14:, 15:театров 16:разного 17:направления 18:.",
      "spans": [
        {
          "start": 2,
          "end": 2,
          "type": "LOC"
        }
      ]
    },
    {
      "id": 24,
      "source_title": "Великий Новгород",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=712875",
      "text": "Новгород издавна вел самостоятельную торговлю с западными купцами и в XIV-XV веках даже был торговым партнером Ганзейского союза, обеспечивая товарообмен между Европой и остальными русскими землями.",
      "numbered_words": "1:Новгород 2:издавна 3:вел 4:самостоятельную 5:торговлю 6:с 7:западными 8:купцами 9:и 10:в 11:XIV-XV 12:веках 13:даже 14:был 15:торговым 16:партнером 17:Ганзейского 18:союза 19:, 20:обеспечивая 21:товарообмен 22:между 23:Европой 24:и 25:остальными 26:русскими 27:землями 28:.",
      "spans": [
        {
          "start": 1,
          "end": 1,
          "type": "LOC"
        },
        {
          "start": 17,
          "end": 18,
          "type": "ORG"
        },
        {
          "start": 23,
          "end": 23,
          "type": "LOC"
        }
      ]
    },
    {
      "id": 25,
      "source_title": "Санкт-Петербург",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=785775",
      "text": "После войны город относительно равномерно развивался во всех направлениях, при этом среди типовой архитектуры тех лет встречаются настоящие шедевры модернизма, многие из которых ныне стали популярными туристическими достопримечательностями наравне с более старыми постройками.",
      "numbered_words": "1:После 2:войны 3:город 4:относительно 5:равномерно 6:развивался 7:во 8:всех 9:направлениях 10:, 11:при 12:этом 13:среди 14:типовой 15:архитектуры 16:тех 17:лет 18:встречаются 19:настоящие 20:шедевры 21:модернизма 22:, 23:многие 24:из 25:которых 26:ныне 27:стали 28:популярными 29:туристическими 30:достопримечательностями 31:наравне 32:с 33:более 34:старыми 35:постройками 36:.",
      "spans": []
    },
    {
      "id": 26,
      "source_title": "Санкт-Петербург",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=785775",
      "text": "Также в окраинных районах работают автобусные маршруты Ленинградской области.",
      "numbered_words": "1:Также 2:в 3:окраинных 4:районах 5:работают 6:автобусные 7:маршруты 8:Ленинградской 9:области 10:.",
      "spans": [
        {
          "start": 8,
          "end": 9,
          "type": "LOC"
        }
      ]
    },
    {
      "id": 27,
      "source_title": "Санкт-Петербург",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=785775",
      "text": "Альтернативный способ изучить город и узнать его изнутри - гулять и общаться с местными жителями и принимать участие в локальных мероприятиях.",
      "numbered_words": "1:Альтернативный 2:способ 3:изучить 4:город 5:и 6:узнать 7:его 8:изнутри 9:- 10:гулять 11:и 12:общаться 13:с 14:местными 15:жителями 16:и 17:принимать 18:участие 19:в 20:локальных 21:мероприятиях 22:.",
      "spans": []
    },
    {
      "id": 28,
      "source_title": "Санкт-Петербург",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=785775",
      "text": "Вагоны разделены на шестиместные купе, в цену билета входит питание в виде сэндвича, бутылки воды и ещё чего-то по мелочи.",
      "numbered_words": "1:Вагоны 2:разделены 3:на 4:шестиместные 5:купе 6:, 7:в 8:цену 9:билета 10:входит 11:питание 12:в 13:виде 14:сэндвича 15:, 16:бутылки 17:воды 18:и 19:ещё 20:чего-то 21:по 22:мелочи 23:.",
      "spans": []
    },
    {
      "id": 29,
      "source_title": "Казань",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=763556",
      "text": "Осмотр достопримечательностей в других районах может потребовать некоторого транспортного планирования.",
      "numbered_words": "1:Осмотр 2:достопримечательностей 3:в 4:других 5:районах 6:может 7:потребовать 8:некоторого 9:транспортного 10:планирования 11:.",
      "spans": []
    },
    {
      "id": 30,
      "source_title": "Великий Новгород",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=712875",
      "text": "Восьмискатное пощипцовое покрытие, часто встречающееся у этих церквей, вошло в обиход лишь в XVI веке и является следствием более поздних перестроек.",
      "numbered_words": "1:Восьмискатное 2:пощипцовое 3:покрытие 4:, 5:часто 6:встречающееся 7:у 8:этих 9:церквей 10:, 11:вошло 12:в 13:обиход 14:лишь 15:в 16:XVI 17:веке 18:и 19:является 20:следствием 21:более 22:поздних 23:перестроек 24:.",
      "spans": []
    },
    {
      "id": 31,
      "source_title": "Казань",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=763556",
      "text": "Частные автобусы и маршрутки отправляются от ж/д вокзала Казань-1, ЦУМа, речного вокзала, площади Тукая, метро Проспект Победы, Советской площади, Компрессорного завода.",
      "numbered_words": "1:Частные 2:автобусы 3:и 4:маршрутки 5:отправляются 6:от 7:ж 8:/ 9:д 10:вокзала 11:Казань 12:- 13:1 14:, 15:ЦУМа 16:, 17:речного 18:вокзала 19:, 20:площади 21:Тукая 22:, 23:метро 24:Проспект 25:Победы 26:, 27:Советской 28:площади 29:, 30:Компрессорного 31:завода 32:.",
      "spans": [
        {
          "start": 11,
          "end": 13,
          "type": "LOC"
        },
        {
          "start": 15,
          "end": 15,
          "type": "ORG"
        },
        {
          "start": 20,
          "end": 21,
          "type": "LOC"
        },
        {
          "start": 24,
          "end": 25,
          "type": "LOC"
        },
        {
          "start": 27,
          "end": 28,
          "type": "LOC"
        },
        {
          "start": 30,
          "end": 31,
          "type": "ORG"
        }
      ]
    },
    {
      "id": 32,
      "source_title": "Санкт-Петербург",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=785775",
      "text": "При этом реформа не затронула пригородные маршруты, с нумерацией от 400 и выше.",
      "numbered_words": "1:При 2:этом 3:реформа 4:не 5:затронула 6:пригородные 7:маршруты 8:, 9:с 10:нумерацией 11:от 12:400 13:и 14:выше 15:.",
      "spans": []
    },
    {
      "id": 33,
      "source_title": "Казань",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=763556",
      "text": "Станция Казань-2 предназначена для транзитных поездов, которые, в свою очередь, на старый вокзал не заходят.",
      "numbered_words": "1:Станция 2:Казань 3:- 4:2 5:предназначена 6:для 7:транзитных 8:поездов 9:, 10:которые 11:, 12:в 13:свою 14:очередь 15:, 16:на 17:старый 18:вокзал 19:не 20:заходят 21:.",
      "spans": [
        {
          "start": 2,
          "end": 4,
          "type": "LOC"
        }
      ]
    },
    {
      "id": 34,
      "source_title": "Санкт-Петербург",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=785775",
      "text": "Большая же их часть относится к категории столовых и рюмочных, причём грань между последними порядком размыта: чаще всего это столовая с раздачей и отдельный прилавок-бар, где наливают алкогольные напитки.",
      "numbered_words": "1:Большая 2:же 3:их 4:часть 5:относится 6:к 7:категории 8:столовых 9:и 10:рюмочных 11:, 12:причём 13:грань 14:между 15:последними 16:порядком 17:размыта 18:: 19:чаще 20:всего 21:это 22:столовая 23:с 24:раздачей 25:и 26:отдельный 27:прилавок-бар 28:, 29:где 30:наливают 31:алкогольные 32:напитки 33:.",
      "spans": []
    },
    {
      "id": 35,
      "source_title": "Санкт-Петербург",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=785775",
      "text": "Тем не менее, на окраинах трамвай до сих пор дополняет метрополитен.",
      "numbered_words": "1:Тем 2:не 3:менее 4:, 5:на 6:окраинах 7:трамвай 8:до 9:сих 10:пор 11:дополняет 12:метрополитен 13:.",
      "spans": []
    },
    {
      "id": 36,
      "source_title": "Великий Новгород",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=712875",
      "text": "До других окрестных церквей и монастырей проще доехать на такси: автобусы ходят редко и большая часть времени уйдет на их ожидание.",
      "numbered_words": "1:До 2:других 3:окрестных 4:церквей 5:и 6:монастырей 7:проще 8:доехать 9:на 10:такси 11:: 12:автобусы 13:ходят 14:редко 15:и 16:большая 17:часть 18:времени 19:уйдет 20:на 21:их 22:ожидание 23:.",
      "spans": []
    },
    {
      "id": 37,
      "source_title": "Великий Новгород",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=712875",
      "text": "Другое, несколько менее удобное направление — Боровичи, где мрачноватый промышленный колорит сливается с необычными достопримечательностями вроде старейшего в России арочного моста через реку Мсту.",
      "numbered_words": "1:Другое 2:, 3:несколько 4:менее 5:удобное 6:направление 7:— 8:Боровичи 9:, 10:где 11:мрачноватый 12:промышленный 13:колорит 14:сливается 15:с 16:необычными 17:достопримечательностями 18:вроде 19:старейшего 20:в 21:России 22:арочного 23:моста 24:через 25:реку 26:Мсту 27:.",
      "spans": [
        {
          "start": 8,
          "end": 8,
          "type": "LOC"
        },
        {
          "start": 21,
          "end": 21,
          "type": "LOC"
        },
        {
          "start": 26,
          "end": 26,
          "type": "LOC"
        }
      ]
    },
    {
      "id": 38,
      "source_title": "Санкт-Петербург",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=785775",
      "text": "По времени скоростной поезд и самолёт практически идентичны: с учётом дороги в аэропорт и времени ожидания вы вряд ли потратите на дорогу меньше тех 4 часов, что едет поезд.",
      "numbered_words": "1:По 2:времени 3:скоростной 4:поезд 5:и 6:самолёт 7:практически 8:идентичны 9:: 10:с 11:учётом 12:дороги 13:в 14:аэропорт 15:и 16:времени 17:ожидания 18:вы 19:вряд 20:ли 21:потратите 22:на 23:дорогу 24:меньше 25:тех 26:4 27:часов 28:, 29:что 30:едет 31:поезд 32:.",
      "spans": []
    },
    {
      "id": 39,
      "source_title": "Казань",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=763556",
      "text": "Система абсолютна хаотична, расписания отсутствуют, а автовокзалы обслуживают лишь дальние межобластные маршруты и горстку официальных маршрутов внутри Татарстана.",
      "numbered_words": "1:Система 2:абсолютна 3:хаотична 4:, 5:расписания 6:отсутствуют 7:, 8:а 9:автовокзалы 10:обслуживают 11:лишь 12:дальние 13:межобластные 14:маршруты 15:и 16:горстку 17:официальных 18:маршрутов 19:внутри 20:Татарстана 21:.",
      "spans": [
        {
          "start": 20,
          "end": 20,
          "type": "LOC"
        }
      ]
    },
    {
      "id": 40,
      "source_title": "Великий Новгород",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=712875",
      "text": "Идут они на петербургский автовокзал (Обводный канал), делая промежуточную остановку у метро Купчино.",
      "numbered_words": "1:Идут 2:они 3:на 4:петербургский 5:автовокзал 6:( 7:Обводный 8:канал 9:) 10:, 11:делая 12:промежуточную 13:остановку 14:у 15:метро 16:Купчино 17:.",
      "spans": [
        {
          "start": 7,
          "end": 8,
          "type": "LOC"
        },
        {
          "start": 16,
          "end": 16,
          "type": "LOC"
        }
      ]
    },
    {
      "id": 41,
      "source_title": "Великий Новгород",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=712875",
      "text": "К слову, форма креста церкви типична для домонгольского периода.",
      "numbered_words": "1:К 2:слову 3:, 4:форма 5:креста 6:церкви 7:типична 8:для 9:домонгольского 10:периода 11:.",
      "spans": []
    },
    {
      "id": 42,
      "source_title": "Великий Новгород",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=712875",
      "text": "С самой древности город существовал по обе стороны реки Волхов: на Софийской и Торговой сторонах.",
      "numbered_words": "1:С 2:самой 3:древности 4:город 5:существовал 6:по 7:обе 8:стороны 9:реки 10:Волхов 11:: 12:на 13:Софийской 14:и 15:Торговой 16:сторонах 17:.",
      "spans": [
        {
          "start": 10,
          "end": 10,
          "type": "LOC"
        },
        {
          "start": 13,
          "end": 13,
          "type": "LOC"
        },
        {
          "start": 15,
          "end": 16,
          "type": "LOC"
        }
      ]
    },
    {
      "id": 43,
      "source_title": "Санкт-Петербург",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=785775",
      "text": "Культовым поездом для перемещения между двумя столицами является Москва–Таллин: он ходит в относительно разумное время и при этом всегда имеет самые дешёвые плацкартные вагоны.",
      "numbered_words": "1:Культовым 2:поездом 3:для 4:перемещения 5:между 6:двумя 7:столицами 8:является 9:Москва 10:– 11:Таллин 12:: 13:он 14:ходит 15:в 16:относительно 17:разумное 18:время 19:и 20:при 21:этом 22:всегда 23:имеет 24:самые 25:дешёвые 26:плацкартные 27:вагоны 28:.",
      "spans": [
        {
          "start": 9,
          "end": 9,
          "type": "LOC"
        },
        {
          "start": 11,
          "end": 11,
          "type": "LOC"
        }
      ]
    },
    {
      "id": 44,
      "source_title": "Санкт-Петербург",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=785775",
      "text": "Автобусы, троллейбусы и трамваи ходят примерно в том же режиме.",
      "numbered_words": "1:Автобусы 2:, 3:троллейбусы 4:и 5:трамваи 6:ходят 7:примерно 8:в 9:том 10:же 11:режиме 12:.",
      "spans": []
    },
    {
      "id": 45,
      "source_title": "Великий Новгород",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=712875",
      "text": "Он включён в Серебряное кольцо России и весьма популярен у туристов, в том числе иностранных.",
      "numbered_words": "1:Он 2:включён 3:в 4:Серебряное 5:кольцо 6:России 7:и 8:весьма 9:популярен 10:у 11:туристов 12:, 13:в 14:том 15:числе 16:иностранных 17:.",
      "spans": []
    },
    {
      "id": 46,
      "source_title": "Санкт-Петербург",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=785775",
      "text": "Путь из Москвы в Санкт-Петербург — с большим отрывом самый популярный маршрут страны.",
      "numbered_words": "1:Путь 2:из 3:Москвы 4:в 5:Санкт-Петербург 6:— 7:с 8:большим 9:отрывом 10:самый 11:популярный 12:маршрут 13:страны 14:.",
      "spans": [
        {
          "start": 3,
          "end": 3,
          "type": "LOC"
        },
        {
          "start": 5,
          "end": 5,
          "type": "LOC"
        }
      ]
    },
    {
      "id": 47,
      "source_title": "Великий Новгород",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=712875",
      "text": "Городской пляж находится прямо под кремлёвскими стенами, между пешеходным мостом и монументом Победы.",
      "numbered_words": "1:Городской 2:пляж 3:находится 4:прямо 5:под 6:кремлёвскими 7:стенами 8:, 9:между 10:пешеходным 11:мостом 12:и 13:монументом 14:Победы 15:.",
      "spans": [
        {
          "start": 13,
          "end": 14,
          "type": "LOC"
        }
      ]
    },
    {
      "id": 48,
      "source_title": "Санкт-Петербург",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=785775",
      "text": "В городе работают все основные российские операторы: «Мегафон», «Билайн», «МТС», «Теле2», «Yota».",
      "numbered_words": "1:В 2:городе 3:работают 4:все 5:основные 6:российские 7:операторы 8:: 9:« 10:Мегафон 11:» 12:, 13:« 14:Билайн 15:» 16:, 17:« 18:МТС 19:» 20:, 21:« 22:Теле 23:2 24:» 25:, 26:« 27:Yota 28:» 29:.",
      "spans": [
        {
          "start": 10,
          "end": 10,
          "type": "ORG"
        },
        {
          "start": 14,
          "end": 14,
          "type": "ORG"
        },
        {
          "start": 18,
          "end": 18,
          "type": "ORG"
        },
        {
          "start": 22,
          "end": 23,
          "type": "ORG"
        },
        {
          "start": 27,
          "end": 27,
          "type": "ORG"
        }
      ]
    },
    {
      "id": 49,
      "source_title": "Санкт-Петербург",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=785775",
      "text": "В Петербурге произошло немало исторических событий, основными из которых являются Дворцовый переворот 1741 года, Восстание декабристов 1825 года, «Кровавое воскресенье» и революция 1905 года, Февральская и Октябрьская революции 1917 года.",
      "numbered_words": "1:В 2:Петербурге 3:произошло 4:немало 5:исторических 6:событий 7:, 8:основными 9:из 10:которых 11:являются 12:Дворцовый 13:переворот 14:1741 15:года 16:, 17:Восстание 18:декабристов 19:1825 20:года 21:, 22:« 23:Кровавое 24:воскресенье 25:» 26:и 27:революция 28:1905 29:года 30:, 31:Февральская 32:и 33:Октябрьская 34:революции 35:1917 36:года 37:.",
      "spans": [
        {
          "start": 2,
          "end": 2,
          "type": "LOC"
        }
      ]
    },
    {
      "id": 50,
      "source_title": "Великий Новгород",
      "source_url": "https://ru.wikivoyage.org/w/index.php?oldid=712875",
      "text": "Пережив административные реформы начала XVIII века, в 1727 году он стал центром Новгородской губернии, а в конце XVIII века началась его регулярная перепланировка.",
      "numbered_words": "1:Пережив 2:административные 3:реформы 4:начала 5:XVIII 6:века 7:, 8:в 9:1727 10:году 11:он 12:стал 13:центром 14:Новгородской 15:губернии 16:, 17:а 18:в 19:конце 20:XVIII 21:века 22:началась 23:его 24:регулярная 25:перепланировка 26:.",
      "spans": [
        {
          "start": 14,
          "end": 15,
          "type": "LOC"
        }
      ]
    }
  ]
}
